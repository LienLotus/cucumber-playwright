{
  "name": "playwright-cucumber-saucedemo",
  "version": "1.0.0",
  "description": "Playwright + Cucumber BDD automation framework for SauceDemo",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js -c cucumber.config.js",
    "test:smoke": "cucumber-js -c cucumber.config.js --tags '@smoke'",
    "test:regression": "cucumber-js -c cucumber.config.js --tags '@regression'",
    "report:allure": "allure generate test-results/allure-results -o test-results/allure-report --clean",
    "report:allure:open": "allure open test-results/allure-report",
    "playwright:install": "npx playwright install"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "typescript",
    "bdd",
    "saucedemo"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^10.0.0",
    "@types/node": "^22.0.0",
    "allure-commandline": "^2.34.1",
    "allure-cucumberjs": "^3.0.0",
    "cucumberjs-allure2-reporter": "^1.3.0",
    "dotenv": "^16.0.0",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.49.0",
    "pngjs": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
